{$SITE_ADDRESS} {
	encode zstd gzip

	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy sfu:3000
	}

	handle /sfu/* {
		reverse_proxy sfu:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
