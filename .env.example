# Hostname served by Caddy. Set this to a DNS name pointed at your server.
SITE_ADDRESS=mirror.example.com

# Public IP announced to browsers for direct WebRTC traffic.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Optional; narrow this range and configure the same UDP/TCP firewall rules.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# Use the same images at every site. Only these runtime settings differ.
# standalone: one local SFU; master: coordinator + SFU; sfu: SFU connected to MASTER_URL.
ROLE=standalone
SITE_ID=local
# Unique HTTPS origin of this site's web/SFU endpoint (required in master/sfu mode).
SFU_PUBLIC_URL=
# Master site's HTTPS origin (required only for ROLE=sfu).
MASTER_URL=
# Same random secret of at least 32 characters on all clustered sites.
CLUSTER_SECRET=
# This SFU's numeric IP reachable by OTHER SFUs (VPN IP or public IP).
# Pipe UDP ports use RTC_MIN_PORT..RTC_MAX_PORT and must be forwarded unchanged.
PIPE_ANNOUNCED_IP=127.0.0.1
# Screen groups (video + optional audio + compatibility video) are distributed
# within each SFU. Set to 2 or more to use multiple cores, up to available cores.
MEDIASOUP_WORKERS=1

# Used by the Cloudflare DNS challenge compose override.
CF_API_TOKEN=replace-with-cloudflare-api-token
